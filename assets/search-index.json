---
layout: null
searchable: false
sitemap: false
---
[
  {% assign pages_with_titles = site.pages | where_exp: "p", "p.title" | where_exp: "p", "p.published != false" | where_exp: "p", "p.searchable != false" %}
  {% assign first_entry = true %}
  {% for page in pages_with_titles %}
    {% unless page.url contains '/assets/' or page.url contains '/search-index' %}
    {% unless first_entry %},{% endunless %}
    {
      "title": {{ page.title | jsonify }},
      "url": "{{ site.baseurl }}{{ page.url }}",
      "summary": {{ page.summary | default: "" | jsonify }},
      "content": {{ page.content | strip_html | truncatewords: 200 | jsonify }},
      "tags": {{ page.tags | default: "" | jsonify }},
      "date": {{ page.date | date: "%Y-%m-%d" | jsonify }}
    }
    {% assign first_entry = false %}
    {% endunless %}
  {% endfor %}
]
